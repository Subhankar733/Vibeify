<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rebornRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090909">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- HOME -->
        <ScrollView
            android:id="@+id/homeScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="34dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIBEIFY"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.30"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="42dp"
                    android:text="Your sound. Your atmosphere."
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Music from this device, shaped around what is playing."
                    android:textColor="#888888"
                    android:textSize="15sp"/>

                <!-- QUICK PLAY -->
                <LinearLayout
                    android:id="@+id/cardQuickPick"
                    android:layout_width="match_parent"
                    android:layout_height="168dp"
                    android:layout_marginTop="38dp"
                    android:orientation="vertical"
                    android:gravity="bottom"
                    android:padding="22dp"
                    android:background="@drawable/reborn_surface">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUICK PLAY"
                        android:textColor="#8A8A8A"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.20"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Drop into your music"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="One tap. Let Vibeify choose."
                        android:textColor="#888888"
                        android:textSize="13sp"/>

                </LinearLayout>

                <!-- LOCAL LIBRARY -->
                <LinearLayout
                    android:id="@+id/cardLocalLibrary"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:background="@drawable/reborn_surface">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Local universe"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="→"
                        android:textColor="#AAAAAA"
                        android:textSize="25sp"/>

                </LinearLayout>

                <!-- LIKED SONGS -->
                <LinearLayout
                    android:id="@+id/cardLikedSongs"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:background="@drawable/reborn_surface">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Loved tracks"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="♡"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"/>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>


        <!-- PLAYER -->
        <ScrollView
            android:id="@+id/playerScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/playerAmbient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="720dp">

                <View
                    android:id="@+id/playerArtGlow"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="90dp"
                    android:background="@drawable/reborn_glow"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:paddingTop="30dp"
                    android:paddingBottom="38dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="NOW IN YOUR SPACE"
                            android:textColor="#A0A0A0"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.20"/>

                        <View
                            android:id="@+id/playerPaletteOrb"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/reborn_orb"/>

                    </LinearLayout>

                    <!-- Artwork stage -->
                    <FrameLayout
                        android:id="@+id/playerArtShell"
                        android:layout_width="match_parent"
                        android:layout_height="350dp"
                        android:layout_marginTop="30dp"
                        android:background="@drawable/reborn_art"
                        android:clipToOutline="true">

                        <ImageView
                            android:id="@+id/imgAlbumArt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:clipToOutline="true"
                            android:contentDescription="Album artwork"/>

                        <View
                            android:id="@+id/playerVibeLine"
                            android:layout_width="82dp"
                            android:layout_height="6dp"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="22dp"
                            android:layout_marginBottom="22dp"
                            android:background="@drawable/reborn_orb"/>

                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtNowPlaying"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:text="Choose your sound"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/txtArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Vibeify"
                        android:textColor="#929292"
                        android:textSize="15sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>


                    <!-- PROGRESS -->
                    <SeekBar
                        android:id="@+id/seekBar"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="24dp"
                        android:splitTrack="false"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtCurrentTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0:00"
                            android:textColor="#888888"
                            android:textSize="11sp"/>

                        <TextView
                            android:id="@+id/txtTotalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0:00"
                            android:textColor="#888888"
                            android:textSize="11sp"/>

                    </LinearLayout>

                    <!-- TRANSPORT -->
                    <LinearLayout
                        android:id="@+id/playerControlDock"
                        android:layout_width="match_parent"
                        android:layout_height="104dp"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/reborn_dock">

                        <ImageButton
                            android:id="@+id/btnPrevious"
                            android:layout_width="62dp"
                            android:layout_height="62dp"
                            android:padding="18dp"
                            android:src="@drawable/ic_previous"
                            android:background="@android:color/transparent"
                            android:contentDescription="Previous"/>

                        <ImageButton
                            android:id="@+id/btnPlay"
                            android:layout_width="78dp"
                            android:layout_height="78dp"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            android:padding="22dp"
                            android:src="@drawable/ic_play"
                            android:background="@drawable/reborn_play"
                            android:contentDescription="Play or pause"/>

                        <ImageButton
                            android:id="@+id/btnNext"
                            android:layout_width="62dp"
                            android:layout_height="62dp"
                            android:padding="18dp"
                            android:src="@drawable/ic_next"
                            android:background="@android:color/transparent"
                            android:contentDescription="Next"/>

                    </LinearLayout>

                    <!-- SECONDARY CONTROLS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnShuffle"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:padding="14dp"
                            android:src="@drawable/ic_shuffle"
                            android:background="@android:color/transparent"
                            android:contentDescription="Shuffle"/>

                        <ImageButton
                            android:id="@+id/btnFavourite"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="30dp"
                            android:layout_marginEnd="30dp"
                            android:padding="14dp"
                            android:src="@drawable/ic_favourite"
                            android:background="@android:color/transparent"
                            android:contentDescription="Favourite"/>

                        <ImageButton
                            android:id="@+id/btnRepeat"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:padding="14dp"
                            android:src="@drawable/ic_repeat"
                            android:background="@android:color/transparent"
                            android:contentDescription="Repeat"/>

                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>
        </ScrollView>


        <!-- LIBRARY -->
        <LinearLayout
            android:id="@+id/libraryScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="34dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COLLECTION"
                android:textColor="#888888"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.24"/>

            <TextView
                android:id="@+id/txtLibraryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Your universe"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtLibrarySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Music living on this device"
                android:textColor="#888888"
                android:textSize="14sp"/>

            <ListView
                android:id="@+id/songList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="26dp"
                android:paddingBottom="20dp"
                android:clipToPadding="false"
                android:divider="#242424"
                android:dividerHeight="1dp"
                android:listSelector="#202020"
                android:scrollbars="none"/>

        </LinearLayout>


        <!-- SETTINGS -->
        <ScrollView
            android:id="@+id/settingsScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="34dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIBEIFY / SYSTEM"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.22"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Make it yours."
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Your music. Your rules. Your atmosphere."
                    android:textColor="#888888"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="42dp"
                    android:padding="22dp"
                    android:text="Playback  →"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/reborn_surface"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="22dp"
                    android:text="Local music  →"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/reborn_surface"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="22dp"
                    android:text="Visual atmosphere  →"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/reborn_surface"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="22dp"
                    android:text="About Vibeify  →"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/reborn_surface"/>

            </LinearLayout>
        </ScrollView>


    </FrameLayout>

    <!-- REBORN NAVIGATION -->
    <LinearLayout
        android:id="@+id/rebornNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#0C0C0C">

        <ImageButton
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:src="@drawable/ic_nav_home"
            android:background="@android:color/transparent"
            android:contentDescription="Home"/>

        <ImageButton
            android:id="@+id/navPlayer"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:src="@drawable/ic_nav_player"
            android:background="@android:color/transparent"
            android:contentDescription="Player"/>

        <ImageButton
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:src="@drawable/ic_nav_library"
            android:background="@android:color/transparent"
            android:contentDescription="Library"/>

        <ImageButton
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:src="@drawable/ic_nav_settings"
            android:background="@android:color/transparent"
            android:contentDescription="Settings"/>

    </LinearLayout>

</LinearLayout>
