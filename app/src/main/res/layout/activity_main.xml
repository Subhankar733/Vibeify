<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#09090B">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- HOME -->
        <ScrollView
            android:id="@+id/homeScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="24dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VIBEIFY"
                            android:textColor="#FFFFFF"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Your music. Your vibe."
                            android:textColor="#9C9CA6"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="♫"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:background="@drawable/home_logo"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="38dp"
                    android:text="Good evening"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Pick up where you left off"
                    android:textColor="#9C9CA6"
                    android:textSize="15sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:background="@drawable/home_quick_card">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="♥"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:background="@drawable/home_accent_square"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="Liked&#10;Songs"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:background="@drawable/home_quick_card">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="☷"
                            android:textColor="#FFFFFF"
                            android:textSize="21sp"
                            android:background="@drawable/home_accent_square"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="Local&#10;Library"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:text="Quick picks"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="@drawable/home_song_card">

                    <TextView
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:gravity="center"
                        android:text="♫"
                        android:textColor="#FFFFFF"
                        android:textSize="27sp"
                        android:background="@drawable/album_art"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="15dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Your local music"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Songs from your device"
                            android:textColor="#92929B"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="#09090B"
                        android:textSize="17sp"
                        android:background="@drawable/home_play_button"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:text="Made for your vibe"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="170dp"
                            android:layout_height="210dp"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:background="@drawable/home_feature_card">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="130dp"
                                android:gravity="center"
                                android:text="♫"
                                android:textColor="#FFFFFF"
                                android:textSize="50sp"
                                android:background="@drawable/album_art"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Daily Vibe"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="170dp"
                            android:layout_height="210dp"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:background="@drawable/home_feature_card">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="130dp"
                                android:gravity="center"
                                android:text="♪"
                                android:textColor="#FFFFFF"
                                android:textSize="50sp"
                                android:background="@drawable/home_alt_art"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="On Repeat"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>
        </ScrollView>

        <!-- PLAYER -->
        <ScrollView
            android:id="@+id/playerScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NOW PLAYING"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/player_card"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="240dp"
                        android:layout_height="240dp"
                        android:gravity="center"
                        android:text="♫"
                        android:textSize="90sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/album_art"/>

                    <TextView
                        android:id="@+id/txtNowPlaying"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose your vibe"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:paddingTop="25dp"/>

                    <TextView
                        android:id="@+id/txtArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Vibeify Music"
                        android:textColor="#9D9DA5"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:paddingTop="7dp"
                        android:paddingBottom="18dp"/>

                    <SeekBar
                        android:id="@+id/seekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:progressTint="#A78BFA"
                        android:thumbTint="#FFFFFF"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:id="@+id/txtCurrentTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0:00"
                            android:textColor="#9D9DA5"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/txtTotalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0:00"
                            android:textColor="#9D9DA5"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnPrevious"
                            android:layout_width="70dp"
                            android:layout_height="58dp"
                            android:text="❮❮"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:backgroundTint="#24242A"/>

                        <Button
                            android:id="@+id/btnPlay"
                            android:layout_width="95dp"
                            android:layout_height="68dp"
                            android:layout_marginHorizontal="16dp"
                            android:text="▶"
                            android:textColor="#09090B"
                            android:textSize="26sp"
                            android:backgroundTint="#FFFFFF"/>

                        <Button
                            android:id="@+id/btnNext"
                            android:layout_width="70dp"
                            android:layout_height="58dp"
                            android:text="❯❯"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:backgroundTint="#24242A"/>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- LIBRARY -->
        <LinearLayout
            android:id="@+id/libraryScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR LIBRARY"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Songs on your device"
                android:textColor="#9D9DA5"
                android:textSize="15sp"
                android:paddingTop="7dp"
                android:paddingBottom="18dp"/>

            <ListView
                android:id="@+id/songList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="#202024"
                android:dividerHeight="1dp"
                android:listSelector="#24242A"/>

        </LinearLayout>

        <!-- SETTINGS -->
        <ScrollView
            android:id="@+id/settingsScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:paddingBottom="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/settings_card"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="◉   Appearance
      Theme, colors and display"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:lineSpacingExtra="5dp"
                        android:padding="18dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#303038" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="♫   Local Library
      Scan music on your device"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:lineSpacingExtra="5dp"
                        android:padding="18dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#303038" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="≋   Audio
      Playback and audio options"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:lineSpacingExtra="5dp"
                        android:padding="18dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:background="@drawable/settings_card"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="▤   Storage &amp; Cache
      Manage local music data"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:lineSpacingExtra="5dp"
                        android:padding="18dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#303038" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ⓘ   About Vibeify
      Version 1.0"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:lineSpacingExtra="5dp"
                        android:padding="18dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#121216">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⌂&#10;HOME"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#121216"/>

        <Button
            android:id="@+id/navPlayer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="♫&#10;PLAYER"
            android:textColor="#A78BFA"
            android:textSize="12sp"
            android:backgroundTint="#121216"/>

        <Button
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="☷&#10;LIBRARY"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#121216"/>

        <Button
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚙&#10;SETTINGS"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:backgroundTint="#121216"/>

    </LinearLayout>

</LinearLayout>
