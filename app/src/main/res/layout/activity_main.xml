<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#09090B"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VIBEIFY"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:paddingTop="28dp"
        android:paddingBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/player_card"
        android:padding="24dp">

        <TextView
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:gravity="center"
            android:text="♫"
            android:textSize="80sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/album_art" />

        <TextView
            android:id="@+id/txtNowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose your vibe"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingTop="22dp" />

        <TextView
            android:id="@+id/txtArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vibeify Music"
            android:textColor="#9D9DA5"
            android:textSize="14sp"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="5dp"
            android:paddingBottom="14dp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="#A78BFA"
            android:thumbTint="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrevious"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:text="❮❮"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#24242A" />

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="90dp"
                android:layout_height="64dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:text="▶"
                android:textSize="25sp"
                android:textColor="#09090B"
                android:backgroundTint="#FFFFFF" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:text="❯❯"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#24242A" />

        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your Library"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingTop="25dp"
        android:paddingBottom="12dp" />

    <ListView
        android:id="@+id/songList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#202024"
        android:dividerHeight="1dp"
        android:listSelector="#24242A"
        android:paddingBottom="12dp" />

</LinearLayout>
