<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rebornRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090909">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- HOME -->
        <ScrollView
            android:id="@+id/homeScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="34dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIBEIFY"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.30"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="42dp"
                    android:text="Music that&#10;feels like yours."
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Your library. Your mood. Nothing in the way."
                    android:textColor="#888888"
                    android:textSize="15sp"/>

                <!-- QUICK PLAY -->
                <LinearLayout
                    android:id="@+id/cardQuickPick"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="38dp"
                    android:orientation="vertical"
                    android:gravity="bottom"
                    android:padding="26dp"
                    android:background="@drawable/reborn_surface">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="START HERE"
                        android:textColor="#8A8A8A"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.20"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Press play.&#10;We’ll take it from here."
                        android:textColor="#FFFFFF"
                        android:textSize="27sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Instant music from your local collection  →"
                        android:textColor="#A0A0A0"
                        android:textSize="13sp"/>

                </LinearLayout>

                <!-- HOME V2 COLLECTION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="YOUR SPACE"
                    android:textColor="#8A8A8A"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.20"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardLocalLibrary"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="7dp"
                        android:orientation="vertical"
                        android:gravity="bottom"
                        android:padding="20dp"
                        android:background="@drawable/reborn_surface">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↗"
                            android:textColor="#AAAAAA"
                            android:textSize="24sp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Library"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="On this device"
                            android:textColor="#858585"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardLikedSongs"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:orientation="vertical"
                        android:gravity="bottom"
                        android:padding="20dp"
                        android:background="@drawable/reborn_surface">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="♡"
                            android:textColor="#FFFFFF"
                            android:textSize="27sp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:text="Loved"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Your favourites"
                            android:textColor="#858585"
                            android:textSize="12sp"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>


        <!-- PLAYER -->
        <ScrollView
            android:id="@+id/playerScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/playerAmbient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="720dp">

                <View
                    android:id="@+id/playerArtGlow"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="90dp"
                    android:background="@drawable/reborn_glow"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:paddingTop="30dp"
                    android:paddingBottom="38dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="NOW IN YOUR SPACE"
                            android:textColor="#A0A0A0"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.20"/>

                        <View
                            android:id="@+id/playerPaletteOrb"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/reborn_orb"/>

                    </LinearLayout>

                    <!-- Artwork stage -->
                    <FrameLayout
                        android:id="@+id/playerArtShell"
                        android:layout_width="match_parent"
                        android:layout_height="350dp"
                        android:layout_marginTop="30dp"
                        android:background="@drawable/reborn_art"
                        android:clipToOutline="true">

                        <ImageView
                            android:id="@+id/imgAlbumArt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:clipToOutline="true"
                            android:contentDescription="Album artwork"/>

                        <View
                            android:id="@+id/playerVibeLine"
                            android:layout_width="82dp"
                            android:layout_height="6dp"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="22dp"
                            android:layout_marginBottom="22dp"
                            android:background="@drawable/reborn_orb"/>

                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtNowPlaying"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:text="Choose your sound"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/txtArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Vibeify"
                        android:textColor="#929292"
                        android:textSize="15sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>


                    <!-- PROGRESS -->
                    <SeekBar
                        android:id="@+id/seekBar"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="24dp"
                        android:splitTrack="false"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtCurrentTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0:00"
                            android:textColor="#888888"
                            android:textSize="11sp"/>

                        <TextView
                            android:id="@+id/txtTotalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0:00"
                            android:textColor="#888888"
                            android:textSize="11sp"/>

                    </LinearLayout>

                    <!-- TRANSPORT -->
                    <LinearLayout
                        android:id="@+id/playerControlDock"
                        android:layout_width="match_parent"
                        android:layout_height="104dp"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/reborn_dock">

                        <ImageButton
                            android:id="@+id/btnPrevious"
                            android:layout_width="62dp"
                            android:layout_height="62dp"
                            android:padding="18dp"
                            android:src="@drawable/ic_previous"
                            android:background="@android:color/transparent"
                            android:contentDescription="Previous"/>

                        <ImageButton
                            android:id="@+id/btnPlay"
                            android:layout_width="78dp"
                            android:layout_height="78dp"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            android:padding="22dp"
                            android:src="@drawable/ic_play"
                            android:background="@drawable/reborn_play"
                            android:contentDescription="Play or pause"/>

                        <ImageButton
                            android:id="@+id/btnNext"
                            android:layout_width="62dp"
                            android:layout_height="62dp"
                            android:padding="18dp"
                            android:src="@drawable/ic_next"
                            android:background="@android:color/transparent"
                            android:contentDescription="Next"/>

                    </LinearLayout>

                    <!-- SECONDARY CONTROLS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnShuffle"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:padding="14dp"
                            android:src="@drawable/ic_shuffle"
                            android:background="@android:color/transparent"
                            android:contentDescription="Shuffle"/>

                        <ImageButton
                            android:id="@+id/btnFavourite"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="30dp"
                            android:layout_marginEnd="30dp"
                            android:padding="14dp"
                            android:src="@drawable/ic_favourite"
                            android:background="@android:color/transparent"
                            android:contentDescription="Favourite"/>

                        <ImageButton
                            android:id="@+id/btnRepeat"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:padding="14dp"
                            android:src="@drawable/ic_repeat"
                            android:background="@android:color/transparent"
                            android:contentDescription="Repeat"/>

                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>
        </ScrollView>


        <!-- LIBRARY -->
        <LinearLayout
            android:id="@+id/libraryScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="34dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR MUSIC"
                android:textColor="#888888"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.24"/>

            <TextView
                android:id="@+id/txtLibraryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Library"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtLibrarySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Everything you keep close."
                android:textColor="#888888"
                android:textSize="14sp"/>

            <ListView
                android:id="@+id/songList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="30dp"
                android:paddingTop="6dp"
                android:paddingBottom="28dp"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp"
                android:listSelector="@android:color/transparent"
                android:scrollbars="none"/>

        </LinearLayout>


        <!-- SETTINGS -->
        <ScrollView
            android:id="@+id/settingsScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="34dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIBEIFY / SYSTEM"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.22"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Make it yours."
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Your music. Your rules. Your atmosphere."
                    android:textColor="#888888"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="42dp"
                    android:padding="22dp"
                    android:text="Playback  →"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/reborn_surface"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="22dp"
                    android:text="Local music  →"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/reborn_surface"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="22dp"
                    android:text="Visual atmosphere  →"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/reborn_surface"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="22dp"
                    android:text="About Vibeify  →"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/reborn_surface"/>

            </LinearLayout>
        </ScrollView>


    </FrameLayout>

    <!-- V2 FLOATING VIBE DOCK -->
    <FrameLayout
        android:id="@+id/vibeDockArea"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/rebornNav"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="7dp"
            android:background="@drawable/v2_dock">

            <ImageButton
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:padding="15dp"
                android:src="@drawable/ic_nav_home"
                android:background="@drawable/v2_nav_active"
                android:contentDescription="Home"/>

            <ImageButton
                android:id="@+id/navPlayer"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:padding="15dp"
                android:src="@drawable/ic_nav_player"
                android:background="@drawable/v2_nav_idle"
                android:contentDescription="Player"/>

            <ImageButton
                android:id="@+id/navLibrary"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:padding="15dp"
                android:src="@drawable/ic_nav_library"
                android:background="@drawable/v2_nav_idle"
                android:contentDescription="Library"/>

            <ImageButton
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:padding="15dp"
                android:src="@drawable/ic_nav_settings"
                android:background="@drawable/v2_nav_idle"
                android:contentDescription="Settings"/>

        </LinearLayout>
    </FrameLayout>

</LinearLayout>
