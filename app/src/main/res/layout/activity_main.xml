<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#05070A">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- HOME -->
        <ScrollView
            android:id="@+id/homeScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="32dp">

                <!-- Brand -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VIBEIFY"
                            android:textColor="#F7F7F3"
                            android:textSize="29sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.10"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Your sound, your space."
                            android:textColor="#7F8882"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:text="♫"
                        android:textColor="#F4F7FB"
                        android:textSize="22sp"
                        android:background="@drawable/home_logo"/>
                </LinearLayout>

                <!-- Greeting -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="38dp"
                    android:text="Good evening"
                    android:textColor="#F7F7F3"
                    android:textSize="27sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Ready for another listening session?"
                    android:textColor="#7F8882"
                    android:textSize="14sp"/>

                <!-- Quick actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardLikedSongs"
                        android:layout_width="0dp"
                        android:layout_height="94dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:background="@drawable/v10_surface">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:gravity="center"
                            android:text="♥"
                            android:textColor="#F4F7FB"
                            android:textSize="21sp"
                            android:background="@drawable/v10_accent"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Liked"
                                android:textColor="#F5F5F2"
                                android:textSize="15sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Songs"
                                android:textColor="#8A928D"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardLocalLibrary"
                        android:layout_width="0dp"
                        android:layout_height="94dp"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:background="@drawable/v10_surface">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:gravity="center"
                            android:text="☷"
                            android:textColor="#F4F7FB"
                            android:textSize="21sp"
                            android:background="@drawable/v10_accent"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Local"
                                android:textColor="#F5F5F2"
                                android:textSize="15sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Library"
                                android:textColor="#8A928D"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Continue listening -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:text="Continue listening"
                    android:textColor="#F7F7F3"
                    android:textSize="21sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:id="@+id/cardQuickPick"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="15dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="13dp"
                    android:background="@drawable/v10_surface">

                    <TextView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:gravity="center"
                        android:text="♫"
                        android:textColor="#F4F7FB"
                        android:textSize="28sp"
                        android:background="@drawable/v10_accent"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="15dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Your local music"
                            android:textColor="#F7F7F3"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Jump back into your collection"
                            android:textColor="#858E88"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="#101410"
                        android:textSize="16sp"
                        android:background="@drawable/v8_play"/>
                </LinearLayout>

                <!-- Collections -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:text="Made for your vibe"
                    android:textColor="#F7F7F3"
                    android:textSize="21sp"
                    android:textStyle="bold"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="174dp"
                            android:layout_height="216dp"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="@drawable/v10_surface_soft">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="145dp"
                                android:gravity="center"
                                android:text="♫"
                                android:textColor="#F4F7FB"
                                android:textSize="46sp"
                                android:background="@drawable/v10_accent"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Daily Vibe"
                                android:textColor="#F7F7F3"
                                android:textSize="15sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="174dp"
                            android:layout_height="216dp"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="@drawable/v10_surface_soft">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="145dp"
                                android:gravity="center"
                                android:text="♪"
                                android:textColor="#F4F7FB"
                                android:textSize="46sp"
                                android:background="@drawable/home_alt_art"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="On Repeat"
                                android:textColor="#F7F7F3"
                                android:textSize="15sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>
        </ScrollView>

        <!-- PLAYER -->
        <ScrollView
            android:id="@+id/playerScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="20dp"
                android:paddingBottom="30dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NOW PLAYING"
                    android:textColor="#7E8781"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.22"
                    android:gravity="center"/>

                <!-- Album art shell -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="330dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/v8_art_border"
                    android:padding="6dp">

                    <!-- This frame clips the real artwork -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/v8_art"
                        android:clipToOutline="true">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="♫"
                            android:textColor="#91A98D"
                            android:textSize="76sp"/>

                        <ImageView
                            android:id="@+id/imgAlbumArt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:clipToOutline="true"
                            android:contentDescription="Album artwork"/>

                    </FrameLayout>
                </FrameLayout>

                <!-- Song info -->
                <TextView
                    android:id="@+id/txtNowPlaying"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="Choose your vibe"
                    android:textColor="#F7F7F3"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/txtArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Vibeify Music"
                    android:textColor="#8D9690"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <!-- Progress -->
                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="21dp"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:progressDrawable="@drawable/v10_seek"
                    android:thumb="@drawable/v10_thumb"
                    android:splitTrack="false"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp">

                    <TextView
                        android:id="@+id/txtCurrentTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0:00"
                        android:textColor="#717A74"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/txtTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="#717A74"
                        android:textSize="11sp"/>

                </LinearLayout>

                <!-- Main controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnShuffle"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:padding="14dp"
                        android:src="@drawable/ic_shuffle"
                        android:contentDescription="Shuffle"
                        android:background="@android:color/transparent"/>

                    <ImageButton
                        android:id="@+id/btnPrevious"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:padding="16dp"
                        android:src="@drawable/ic_previous"
                        android:contentDescription="Previous"
                        android:background="@android:color/transparent"/>

                    <ImageButton
                        android:id="@+id/btnPlay"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:padding="22dp"
                        android:src="@drawable/ic_play"
                        android:contentDescription="Play or pause"
                        android:background="@drawable/v10_play"/>

                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:padding="16dp"
                        android:src="@drawable/ic_next"
                        android:contentDescription="Next"
                        android:background="@android:color/transparent"/>

                    <ImageButton
                        android:id="@+id/btnRepeat"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:padding="14dp"
                        android:src="@drawable/ic_repeat"
                        android:contentDescription="Repeat"
                        android:background="@android:color/transparent"/>

                </LinearLayout>

                <!-- Favourite -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnFavourite"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_favourite"
                        android:contentDescription="Favourite"
                        android:background="@drawable/v10_mode_off"/>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- LIBRARY -->
        <LinearLayout
            android:id="@+id/libraryScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIBEIFY"
                android:textColor="#A9C7FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"/>

            <TextView
                android:id="@+id/txtLibraryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="YOUR LIBRARY"
                android:textColor="#F5F3EE"
                android:textSize="30sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtLibrarySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Songs on your device"
                android:textColor="#858B87"
                android:textSize="14sp"/>

            <!-- Library status card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/v7_surface">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="♫"
                    android:textColor="#0A0D0B"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="@drawable/v7_accent"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Local music"
                        android:textColor="#F5F3EE"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Ready to play from your device"
                        android:textColor="#7E8580"
                        android:textSize="12sp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#A9C7FF"
                    android:textSize="28sp"/>

            </LinearLayout>

            <!-- Songs label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Songs"
                    android:textColor="#F5F3EE"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCAL"
                    android:textColor="#747B76"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"/>

            </LinearLayout>

            <ListView
                android:id="@+id/songList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="4dp"
                android:paddingBottom="12dp"
                android:clipToPadding="false"
                android:divider="#1C211E"
                android:dividerHeight="1dp"
                android:listSelector="#202722"
                android:scrollbars="none"/>

        </LinearLayout>

        <!-- SETTINGS -->
        <ScrollView
            android:id="@+id/settingsScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="24dp"
                android:paddingBottom="36dp">

                <!-- Premium header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIBEIFY"
                    android:textColor="#A9C7FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Settings"
                    android:textColor="#F5F3EE"
                    android:textSize="32sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Make Vibeify feel like yours"
                    android:textColor="#818882"
                    android:textSize="14sp"/>

                <!-- Playback -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="10dp"
                    android:text="PLAYBACK"
                    android:textColor="#6F776F"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:background="@drawable/v8_settings_section">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="♫"
                            android:textColor="#9DB697"
                            android:textSize="20sp"
                            android:background="@drawable/v8_settings_icon"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Audio"
                                android:textColor="#F2F1EC"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Playback and audio options"
                                android:textColor="#949BA7"
                                android:textSize="12sp"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#737B74"
                            android:textSize="28sp"/>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="72dp"
                        android:background="#202620"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="☷"
                            android:textColor="#9DB697"
                            android:textSize="20sp"
                            android:background="@drawable/v8_settings_icon"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Local Library"
                                android:textColor="#F2F1EC"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Music stored on your device"
                                android:textColor="#949BA7"
                                android:textSize="12sp"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#737B74"
                            android:textSize="28sp"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Personalisation -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
